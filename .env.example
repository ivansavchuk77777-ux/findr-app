# Mobile/web app — these are public client-side values, not service-role secrets.
EXPO_PUBLIC_FINDR_API_URL=http://192.168.1.100:8787
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend only — never expose provider secrets with EXPO_PUBLIC_ variables.
PORT=8787
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Add approved provider keys here as adapters are connected.
